{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartexcelextractor.local/schema/result-v2.json",
  "title": "SmartExcelExtractor hasil ekstraksi v2",
  "description": "Berlaku untuk mode compact (default) dan full. Lihat docs/SPEC.md poin 4.",
  "type": "object",
  "required": ["meta", "data"],
  "additionalProperties": false,
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "data": {
      "type": "object",
      "description": "Per folder sumber, lalu per sheet: daftar entri item.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": { "$ref": "#/$defs/item" }
        }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["status", "source", "sheet", "values", "issues", "content_hash"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "description": "Identitas item; hanya ditulis bila terbaca. Tanpanya lihat key_issue."
        },
        "status": { "enum": ["ok", "warning", "error"] },
        "source": {
          "type": "object",
          "required": ["folder", "file", "file_modified"],
          "additionalProperties": false,
          "properties": {
            "folder": { "type": ["string", "null"] },
            "file": { "type": ["string", "null"] },
            "file_modified": { "type": ["string", "null"] }
          }
        },
        "sheet": { "type": "string" },
        "values": {
          "type": "object",
          "description": "Nama hasil -> nilai. Field yang gagal bernilai null.",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null", "array", "object"]
          }
        },
        "issues": {
          "type": "object",
          "description": "Hanya field yang menyimpang dari ok; tidak ada di sini berarti ok.",
          "additionalProperties": { "$ref": "#/$defs/issue" }
        },
        "content_hash": {
          "type": "string",
          "description": "SHA-256 dari values saja, sehingga run_at tidak mengubahnya."
        },
        "key_issue": { "$ref": "#/$defs/keyIssue" },
        "detail": {
          "type": "object",
          "description": "Hanya di mode full: jejak lengkap setiap field.",
          "additionalProperties": { "$ref": "#/$defs/detailEntry" }
        }
      }
    },
    "issue": {
      "type": "object",
      "required": ["status", "code", "at"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["warning", "error"] },
        "code": {
          "enum": [
            "FILE_NOT_FOUND",
            "FILE_UNREADABLE",
            "MULTIPLE_FILES",
            "SHEET_NOT_FOUND",
            "SHEET_AMBIGUOUS",
            "KEYWORD_NOT_FOUND",
            "UNIQUE_VIOLATION",
            "AMBIGUOUS_AFTER_DISAMBIGUATION",
            "ADDRESS_DRIFT",
            "EMPTY_VALUE",
            "TYPE_MISMATCH",
            "FORMULA_NOT_CALCULATED",
            "EXCEL_ERROR_VALUE",
            "MERGED_CELL",
            "DATE_CONFLICT",
            "KEY_NOT_FOUND",
            "SHEET_ABSENT",
            "SHEET_UNMATCHED",
            "INTERNAL_ERROR"
          ]
        },
        "at": { "type": ["string", "null"], "description": "Alamat sel hasil, mis. L45." },
        "raw": { "type": "string", "description": "Teks tersimpan, hanya bila beda dari nilai." },
        "merged_range": { "type": "string", "description": "Range merged, mis. I45:L45." }
      }
    },
    "keyIssue": {
      "type": "object",
      "required": ["status", "code", "message"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["warning", "error"] },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "detailEntry": {
      "type": "object",
      "required": [
        "status",
        "value_address",
        "row_keyword_address",
        "col_keyword_address",
        "raw_value",
        "type_found",
        "merged_range",
        "from_formula",
        "hidden"
      ],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["ok", "warning", "error"] },
        "value_address": { "type": ["string", "null"] },
        "row_keyword_address": { "type": ["string", "null"] },
        "col_keyword_address": { "type": ["string", "null"] },
        "raw_value": { "type": ["string", "null"] },
        "type_found": { "type": "string" },
        "merged_range": { "type": ["string", "null"] },
        "from_formula": { "type": "boolean" },
        "hidden": { "type": "boolean" }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "app_version",
        "schema_version",
        "mode",
        "profile",
        "run_at",
        "summary",
        "unmatched_sheets"
      ],
      "additionalProperties": false,
      "properties": {
        "app_version": { "type": ["string", "null"] },
        "schema_version": { "const": 2 },
        "mode": { "enum": ["compact", "full"] },
        "profile": { "type": ["string", "null"] },
        "run_at": { "type": ["string", "null"], "description": "ISO 8601." },
        "summary": {
          "type": "object",
          "required": ["sheets", "total_fields", "ok", "warning", "error"],
          "additionalProperties": false,
          "properties": {
            "sheets": { "type": "integer", "minimum": 0 },
            "total_fields": { "type": "integer", "minimum": 0 },
            "ok": { "type": "integer", "minimum": 0 },
            "warning": { "type": "integer", "minimum": 0 },
            "error": { "type": "integer", "minimum": 0 }
          }
        },
        "unmatched_sheets": {
          "type": "array",
          "description": "Sheet yang tidak dipakai template mana pun.",
          "items": {
            "type": "object",
            "required": ["folder", "file", "sheet", "reason"],
            "additionalProperties": false,
            "properties": {
              "folder": { "type": ["string", "null"] },
              "file": { "type": ["string", "null"] },
              "sheet": { "type": ["string", "null"] },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
